local function tremerCamera(duracao, forca)
	local cam = camera()
	local inicio = os.clock()

	RunService:BindToRenderStep("TremorReiniciar", Enum.RenderPriority.Camera.Value + 1, function()
		local passado = os.clock() - inicio
		if passado >= duracao then
			RunService:UnbindFromRenderStep("TremorReiniciar")
			return
		end

		local intensidade = forca * (1 - passado / duracao)
		local deslocamento = Vector3.new(
			(math.random() - 0.5) * intensidade,
			(math.random() - 0.5) * intensidade,
			0
		)
		cam.CFrame = cam.CFrame * CFrame.new(deslocamento)
	end)
end

local function mundoVirandoPo(duracao)
	local correcao = Instance.new("ColorCorrectionEffect")
	correcao.Parent = Lighting
	tween(correcao, 0.4, {
		Saturation = -1,
		TintColor = Color3.fromRGB(200, 180, 160),
	})

	task.delay(duracao, function()
		tween(correcao, 1.5, {
			Saturation = 0,
			TintColor = Color3.new(1, 1, 1),
		})
		Debris:AddItem(correcao, 1.6)
	end)
end

