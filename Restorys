--// Utilidades
local function tocarSom(id, volume, velocidade)
	if not id or id == "" then return end

	local som = Instance.new("Sound")
	som.SoundId = id
	som.Volume = volume or 1
	som.PlaybackSpeed = velocidade or 1
	som.Parent = SoundService
	som:Play()
	Debris:AddItem(som, 8)
end

local function tween(objeto, duracao, propriedades, estilo, direcao)
	local info = TweenInfo.new(
		duracao,
		estilo or Enum.EasingStyle.Quad,
		direcao or Enum.EasingDirection.Out
	)
	local t = TweenService:Create(objeto, info, propriedades)
	t:Play()
	return t
end

