--// Sistema de Liberação e Reset Real
local function atravessaFronteira(objeto, pecasDoPersonagem)
	local a, b

	if objeto:IsA("JointInstance") or objeto:IsA("WeldConstraint") then
		a, b = objeto.Part0, objeto.Part1
	elseif objeto:IsA("Constraint") then
		a = objeto.Attachment0 and objeto.Attachment0.Parent
		b = objeto.Attachment1 and objeto.Attachment1.Parent
	else
		return false
	end

	return (pecasDoPersonagem[a] == true) ~= (pecasDoPersonagem[b] == true)
end

local function soltarAgarres(personagem)
	local pecas = {}
	for _, obj in ipairs(personagem:GetDescendants()) do
		if obj:IsA("BasePart") then
			pecas[obj] = true
		end
	end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if atravessaFronteira(obj, pecas) then
			pcall(function()
				obj:Destroy()
			end)
		end
	end
end

local function sumirEmPo(personagem)
	local partes = {}
	for _, obj in ipairs(personagem:GetDescendants()) do
		if obj:IsA("BasePart") then
			table.insert(partes, obj)
		end
	end

	for _, parte in ipairs(partes) do
		task.delay(math.random() * 0.7, function()
			if not parte.Parent then return end

			local po = Instance.new("ParticleEmitter")
			po.Texture = "rbxasset://textures/particles/smoke_main.dds"
			po.Color = ColorSequence.new(CONFIG.Cores.Poeira)
			po.Lifetime = NumberRange.new(0.8, 1.8)
			po.Speed = NumberRange.new(2, 7)
			po.SpreadAngle = Vector2.new(180, 180)
			po.Rate = 0
			po.LightEmission = 0
			po.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.5),
				NumberSequenceKeypoint.new(1, 2.5),
			})
			po.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.1),
				NumberSequenceKeypoint.new(1, 1),
			})
			po.Parent = parte
			po:Emit(20)
			Debris:AddItem(po, 3)

			tween(parte, 1.4, {LocalTransparencyModifier = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end)
	end
end

-- Função que realmente mata o personagem, solta agarres e quebra juntas
local function reiniciarPersonagem(personagem)
	soltarAgarres(personagem)
	sumirEmPo(personagem)

	local humanoide = personagem:FindFirstChildOfClass("Humanoid")
	if humanoide and humanoide.Health > 0 then
		humanoide.Health = 0
	end

	pcall(function()
		personagem:BreakJoints()
	end)
end

--// Peças 3D do menu
local function escalaPixels(distancia)
	local cam = camera()
	local alturaMeia = distancia * math.tan(math.rad(cam.FieldOfView) / 2)
	return (cam.ViewportSize.Y / 2) / alturaMeia
end

local function telaParaMundo(sx, sy, distancia)
	local cam = camera()
	local pxPorStud = escalaPixels(distancia)
	local meio = cam.ViewportSize / 2
	local x = (sx - meio.X) / pxPorStud
	local y = -(sy - meio.Y) / pxPorStud

	return cam.CFrame * CFrame.new(x, y, -distancia) * CFrame.Angles(0, math.pi, 0)
end

local function criarPecas()
	local d = CONFIG.Distancia
	local pxPorStud = escalaPixels(d)
	local origem = menu.AbsolutePosition
	local tamanho = menu.AbsoluteSize
	local largura = tamanho.X / CONFIG.Colunas
	local altura = tamanho.Y / CONFIG.Linhas
	local pecas = {}

	for linha = 0, CONFIG.Linhas - 1 do
		for coluna = 0, CONFIG.Colunas - 1 do
			local sx = origem.X + coluna * largura + largura / 2
			local sy = origem.Y + linha * altura + altura / 2
			local base = telaParaMundo(sx, sy, d)

			local parte = Instance.new("Part")
			parte.Name = "Peca"
			parte.Anchored = true
			parte.CanCollide = false
			parte.CanQuery = false
			parte.CanTouch = false
			parte.CastShadow = false
			parte.Material = Enum.Material.SmoothPlastic
			parte.Color = CONFIG.Cores.Fundo
			parte.Size = Vector3.new(largura / pxPorStud, altura / pxPorStud, 0.2)
			parte.CFrame = base
			parte.Parent = pastaPecas

			local superficie = Instance.new("SurfaceGui")
			superficie.Face = Enum.NormalId.Front
			superficie.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
			superficie.CanvasSize = Vector2.new(math.ceil(largura), math.ceil(altura))
			superficie.PixelsPerStud = pxPorStud
			superficie.LightInfluence = 0
			superficie.AlwaysOnTop = true
			superficie.Parent = parte

			local janela = Instance.new("Frame")
			janela.Size = UDim2.fromScale(1, 1)
			janela.BackgroundTransparency = 1
			janela.ClipsDescendants = true
			janela.Parent = superficie

			local copia = menu:Clone()
			copia.Visible = true
			copia.Size = UDim2.fromOffset(tamanho.X, tamanho.Y)
			copia.Position = UDim2.fromOffset(-coluna * largura, -linha * altura)
			copia.Parent = janela

			table.insert(pecas, {parte = parte, base = base})
		end
	end

	return pecas
end

local function explodirPecas(pecas, centro)
	for _, p in ipairs(pecas) do
		local saida = p.base.Position - centro
		local direcao
		if saida.Magnitude < 0.1 then
			direcao = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
		else
			direcao = saida.Unit
		end

		local destino = p.base.Position
			+ direcao * math.random(4, 9)
			+ Vector3.new(math.random(-2, 2), math.random(-2, 2), math.random(-2, 2))
		local giro = CFrame.Angles(
			math.random() * math.pi * 2,
			math.random() * math.pi * 2,
			math.random() * math.pi * 2
		)

		tween(p.parte, CONFIG.TempoVoo, {CFrame = CFrame.new(destino) * giro}, Enum.EasingStyle.Quint)
	end
end

