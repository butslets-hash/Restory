	laser.Size = Vector3.new(0.12, 0.12, 1)
	laser.Transparency = 1
	laser.Parent = pastaPecas
	return laser
end

local function atualizarLaser(laser, de, para)
	local distancia = (para - de).Magnitude
	if distancia < 0.01 then
		laser.Transparency = 1
		return
	end

	laser.Transparency = 0
	laser.Size = Vector3.new(0.12, 0.12, distancia)
	laser.CFrame = CFrame.lookAt(de:Lerp(para, 0.5), para)
end

local function puxarPecas(pecas, orb)
	local ligacoes = {}
	local concluidas = 0

	local conexao = RunService.RenderStepped:Connect(function()
		for i = #ligacoes, 1, -1 do
			local ligacao = ligacoes[i]
			if ligacao.laser.Parent and ligacao.peca.Parent then
				local tremor = Vector3.new(
					(math.random() - 0.5) * 0.4,
					(math.random() - 0.5) * 0.4,
					(math.random() - 0.5) * 0.4
				)
				atualizarLaser(ligacao.laser, orb.Position, ligacao.peca.Position + tremor)
			else
				table.remove(ligacoes, i)
			end
		end
	end)

	for i, p in ipairs(pecas) do
		task.delay(i * 0.03 + math.random() * 0.35, function()
			local laser = criarLaser()
			table.insert(ligacoes, {laser = laser, peca = p.parte})
			emitirFaiscas(p.parte, 12)
			tocarSom(CONFIG.Sons.Laser, 0.3, 1 + math.random() * 0.5)

			local t = tween(
				p.parte,
				CONFIG.TempoPuxada,
				{CFrame = p.base},
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.InOut
			)

			t.Completed:Connect(function()
				laser:Destroy()
				emitirFaiscas(p.parte, 10)
				concluidas = concluidas + 1
			end)
		end)
	end

	repeat task.wait() until concluidas >= #pecas
	conexao:Disconnect()
end

--// Sequência principal
local function sequenciaReiniciar()
	if ocupado then return end
	ocupado = true
	tocarSom(CONFIG.Sons.Clique, 0.8, 0.9)

	local centroMenu = menu.AbsolutePosition + menu.AbsoluteSize / 2
	local centro = telaParaMundo(centroMenu.X, centroMenu.Y, CONFIG.Distancia).Position

	local pecas = criarPecas()
	menu.Visible = false

	-- 1) Impacto
	tocarSom(CONFIG.Sons.Explosao, 1, 1)
	tocarSom(CONFIG.Sons.Impacto, 0.7, 0.8)
	criarFlash()
	tremerCamera(0.9, 1.6)
	mundoVirandoPo(2.4)
	explosaoPoeira(centro)
	ondaPoeira(centro)

	-- 2) Peças voam e o personagem reseta de verdade (solta agarres e mata)
	tocarSom(CONFIG.Sons.Voo, 0.6, 0.9)
	explodirPecas(pecas, centro)
	task.delay(0.3, function()
		local personagem = jogador.Character
		if personagem then
			reiniciarPersonagem(personagem)
		end
	end)

	-- 3) Bola preta e lasers puxam as peças de volta
	task.wait(0.9)
	local orb = criarOrb(centro)
	tocarSom(CONFIG.Sons.Energia, 0.8, 1)
	task.wait(0.4)
	puxarPecas(pecas, orb)

	-- 4) A bola some e o menu volta inteiro
	tocarSom(CONFIG.Sons.Energia, 0.5, 1.4)
	emitirFaiscas(orb, 25)
	tween(orb, 0.35, {Size = Vector3.new(0.1, 0.1, 0.1)}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.wait(0.4)

	pastaPecas:ClearAllChildren()
	menu.Visible = true
	ocupado = false
end

--// Minimizar
local function alternarMinimizar()
	minimizado = not minimizado
	botaoMinimizar.Text = minimizado and "+" or "-"

	if not minimizado then
		conteudo.Visible = true
	end

	local alturaFinal = minimizado and CONFIG.AlturaBarra or CONFIG.TamanhoMenu.Y
	tween(menu, 0.4, {
		Size = UDim2.fromOffset(CONFIG.TamanhoMenu.X, alturaFinal),
	}, Enum.EasingStyle.Quint)

	task.delay(0.4, function()
		conteudo.Visible = not minimizado
	end)

	tocarSom(CONFIG.Sons.Clique, 0.6, minimizado and 0.85 or 1.15)
end

--// Arrastar (mouse e toque)
barra.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		arrastando = true
		inicioMouse = input.Position
		inicioMenu = menu.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		arrastando = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not arrastando then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - inicioMouse
		menu.Position = UDim2.new(
			inicioMenu.X.Scale, inicioMenu.X.Offset + delta.X,
			inicioMenu.Y.Scale, inicioMenu.Y.Offset + delta.Y
		)
	end
end)

